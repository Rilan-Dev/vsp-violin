# Copy to `.env` and fill in. NEVER commit the real `.env`.

# Local dev: SQLite. Production: the Supabase pooled Postgres URL.
DATABASE_URL="file:./db/custom.db"
# Production only — Supabase direct (non-pooled) connection, used by `directUrl`.
# DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Server-only; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Static fallback token for the Studio API in local dev.
# Leave UNSET in production: Studio auth then requires a real Supabase session.
# There is deliberately no default — a missing value denies access.
STUDIO_TOKEN=

# Canonical public origin used for metadata, sitemap.xml and robots.txt.
# Must point at the origin actually serving this deployment, or search engines
# are told the real page lives somewhere else.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — where new enquiry notifications are sent. If either is unset,
# notification is skipped and the enquiry is still saved.
# RESEND_API_KEY=
# ENQUIRY_NOTIFY_TO=

NEXT_TELEMETRY_DISABLED=1
