// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lesson {
  id               String   @id
  title            String
  titleTamil       String?
  category         String
  level            Int?
  raga             String?
  thala            String?
  composer         String?
  date             String
  notationTamil    String?
  notationEnglish  String?
  violinVideo      String?
  vocalVideo       String?
  titleCard        String?
  sourceUrl        String?
  perVideoEmbeds   String?
  audioLessons     String?
  videoParts       String?
  status           String   @default("published")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Category {
  slug   String @id
  name   String
  group  String
  order  Int
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  city      String?
  intent    String
  instrument String?
  level     String?
  whoFor    String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([intent])
}

// Site content — key/value store for editable text content
// Keys: hero_title, hero_subtitle, hero_eyebrow, marquee_items,
//       about_bio_1..5, about_role, guru_lineage, mission_1..4, vision_1..4,
//       testimonials_json, contact_email, contact_phone, contact_address,
//       social_youtube, social_facebook, social_instagram, social_twitter,
//       seo_title, seo_description, seo_keywords
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Media library — upload/manage images
model Media {
  id        String   @id @default(cuid())
  url       String
  altText   String
  category  String   // portrait | title-card | gallery | honours | misc
  createdAt DateTime @default(now())

  @@index([category])
}
